{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "prompt",
    "dimension"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "dimension": {
      "enum": [
        "routing",
        "fidelity",
        "boundary",
        "composition",
        "task_gain"
      ]
    },
    "expected_route": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
